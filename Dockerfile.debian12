FROM debian:12

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# CRITICAL: Simulate fresh ISO install
# The Docker image represents the ISO state - we keep it as-is
# DO NOT run apt update - this simulates offline PC that never touched internet

# Only install sudo if not present (minimal change to base image)
RUN if ! dpkg -l sudo 2>/dev/null | grep -q ^ii; then \
        apt-get update && \
        apt-get install -y sudo && \
        rm -rf /var/lib/apt/lists/*; \
    fi

# Create a test user (similar to your offline PC)
RUN useradd -m -s /bin/bash testuser && \
    echo "testuser ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Set working directory
WORKDIR /home/testuser/veracrypt-test

# Switch to test user
USER testuser

CMD ["/bin/bash"]
